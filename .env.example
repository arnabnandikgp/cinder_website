# Optional canonical production URL, e.g. https://your-domain.com
# Social and contact destinations are configured in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Optional public waitlist. All values below are SERVER-side only.
# Cinder Waitlist is Brevo list #3. See docs/waitlist-setup.md.
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=3
BREVO_WAITLIST_DOI_TEMPLATE_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
